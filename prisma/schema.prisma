generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

// Units: odometer in tenths of a km, volume in millilitres, money in paise.
// Integers keep money, fuel and distance exact.

model User {
  id        String    @id // Supabase auth user id
  name      String?
  lowFuelKm Int? // low-fuel reminder threshold in km; null = reminders off
  createdAt DateTime  @default(now())
  vehicles  Vehicle[]
}

model Vehicle {
  id             String   @id @default(uuid())
  userId         String
  name           String
  kind           String
  startOdometer  Int
  tankCapacityMl Int?
  reserveMl      Int?
  archived       Boolean  @default(false)
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  events         Event[]

  @@index([userId])
}

enum EventKind {
  FILL
  RESERVE
  ODOMETER
}

model Event {
  id             String    @id // client-generated uuid, so offline retries are idempotent
  userId         String
  vehicleId      String
  kind           EventKind
  occurredAt     DateTime
  odometer       Int? // null only for a reserve mark whose reading is not known yet
  odometerApprox Boolean   @default(false)
  volumeMl       Int?
  amountPaise    Int?
  pricePaise     Int? // per litre
  fullTank       Boolean   @default(false)
  note           String?
  createdAt      DateTime  @default(now())
  vehicle        Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, occurredAt])
  @@index([userId])
}
