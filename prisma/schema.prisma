generator client {
  provider = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String       @id
  vehicles    Vehicle[]
  userProfile UserProfile?
}

model Vehicle {
  id               String      @id @default(uuid())
  userId           String
  name             String
  vehicleType      String      @default("Unknown")
  initial_odometer Float
  created_at       DateTime    @default(now())
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  fuelEntries      FuelEntry[]
}

model FuelEntry {
  id          String   @id @default(uuid())
  userId      String
  vehicleId   String?
  odometer    Float
  fuel_price  Float
  amount_paid Float
  fuel_volume Float
  is_reserve  Boolean
  filled_at   DateTime @default(now())
  created_at  DateTime @default(now())
  vehicle     Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([userId, vehicleId, filled_at])
}

model UserProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  name      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
