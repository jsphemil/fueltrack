generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

// Units: odometer in tenths of a km, volume in millilitres, money in paise.
// Integers keep money, fuel and distance exact.

model User {
  id        String     @id // Supabase auth user id
  name      String?
  lowFuelKm Int? // low-fuel reminder threshold in km; null = reminders off
  createdAt DateTime   @default(now())
  vehicles  Vehicle[]
  documents Document[]
}

model Vehicle {
  id                  String          @id @default(uuid())
  userId              String
  name                String
  kind                String
  startOdometer       Int
  tankCapacityMl      Int?
  reserveMl           Int?
  // Deprecated: copied into ServiceItem ("Engine oil") by 20261012090000_service_log; drop later.
  serviceIntervalKm   Int?
  lastServiceOdometer Int?
  archived            Boolean         @default(false)
  createdAt           DateTime        @default(now())
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  events              Event[]
  documents           Document[]
  serviceItems        ServiceItem[]
  serviceRecords      ServiceRecord[]
  issues              Issue[]
  expenses            Expense[]

  @@index([userId])
}

enum EventKind {
  FILL
  RESERVE
  ODOMETER
}

model Event {
  id             String    @id // client-generated uuid, so offline retries are idempotent
  userId         String
  vehicleId      String
  kind           EventKind
  occurredAt     DateTime
  odometer       Int? // null only for a reserve mark whose reading is not known yet
  odometerApprox Boolean   @default(false)
  volumeMl       Int?
  amountPaise    Int?
  pricePaise     Int? // per litre
  fullTank       Boolean   @default(false)
  note           String?
  createdAt      DateTime  @default(now())
  vehicle        Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, occurredAt])
  @@index([userId])
}

// Insurance, PUC, RC, licence... with an expiry date to be reminded about.
model Document {
  id        String   @id @default(uuid())
  userId    String
  vehicleId String? // null for personal documents such as a driving licence
  kind      String
  expiresOn DateTime @db.Date
  note      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Something to service regularly (engine oil, chain, air filter...), due by
// distance and/or time since it was last done.
model ServiceItem {
  id               String              @id @default(uuid())
  userId           String
  vehicleId        String
  name             String
  intervalKm       Int? // whole km
  intervalMonths   Int?
  baselineOdometer Int // tenths of km: last done before any record was logged
  baselineDate     DateTime            @db.Date
  createdAt        DateTime            @default(now())
  vehicle          Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  records          ServiceRecordItem[]

  @@index([vehicleId])
}

// One visit to the mechanic (or a DIY job): what was done, when, and the cost.
model ServiceRecord {
  id         String              @id @default(uuid())
  userId     String
  vehicleId  String
  kind       String              @default("MAINTENANCE") // MAINTENANCE or REPAIR
  occurredOn DateTime            @db.Date
  odometer   Int // tenths of km
  costPaise  Int?
  note       String?
  createdAt  DateTime            @default(now())
  vehicle    Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  items      ServiceRecordItem[]
  issues     Issue[]

  @@index([vehicleId, occurredOn])
}

model ServiceRecordItem {
  recordId String
  itemId   String
  record   ServiceRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  item     ServiceItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([recordId, itemId])
  @@index([itemId])
}

// A problem noticed with the vehicle ("brake squeal"). Open until a service
// record fixes it; deleting that record reopens it.
model Issue {
  id        String         @id @default(uuid())
  userId    String
  vehicleId String
  title     String
  notedOn   DateTime       @db.Date
  recordId  String? // the visit that fixed it; null = open
  createdAt DateTime       @default(now())
  vehicle   Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  record    ServiceRecord? @relation(fields: [recordId], references: [id], onDelete: SetNull)

  @@index([vehicleId])
  @@index([recordId])
}

// Money spent on the vehicle outside fuel and service visits (parts, insurance,
// parking, tolls...). Feeds the cost of ownership.
model Expense {
  id          String   @id @default(uuid())
  userId      String
  vehicleId   String
  category    String
  occurredOn  DateTime @db.Date
  amountPaise Int
  note        String?
  createdAt   DateTime @default(now())
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, occurredOn])
}
